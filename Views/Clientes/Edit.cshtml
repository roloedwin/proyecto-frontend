@model TallerMecanico.Models.Cliente

<h1 class="text-2xl font-bold mb-4">Editar Cliente</h1>

<form asp-action="Edit">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="border p-2 w-full" />
    </div>

    <div class="mb-3">
        <label>Teléfono</label>
        <input asp-for="Telefono" class="border p-2 w-full" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="border p-2 w-full" />
    </div>

    <button class="bg-green-500 text-white px-4 py-2 rounded">
        Guardar cambios
    </button>

</form>