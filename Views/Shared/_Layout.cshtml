<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TallerMecanico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TallerMecanico.styles.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800">
    <div class="flex min-h-screen bg-[radial-gradient(circle_at_top,_rgba(14,165,233,0.08),_transparent_35%),linear-gradient(180deg,_#f8fafc_0%,_#e2e8f0_100%)]">
        <aside class="flex w-72 flex-col justify-between border-r border-slate-800/40 bg-slate-950 px-6 py-7 text-slate-100 shadow-2xl">
            <div>
                <div class="mb-8 rounded-3xl border border-white/10 bg-white/5 p-5 backdrop-blur">
                    <p class="text-xs uppercase tracking-[0.35em] text-cyan-300">dashboard</p>
                    <h2 class="mt-3 text-2xl font-black leading-tight">Taller Mecanico<br />Senora Burgos</h2>
                    <p class="mt-3 text-sm text-slate-300">Control operativo del taller con acceso protegido.</p>
                </div>

                <nav class="space-y-2 text-sm font-medium">
                    <a asp-controller="Home" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Inicio</a>
                    <a asp-controller="Clientes" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Clientes</a>
                    <a asp-controller="Vehiculos" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Vehiculos</a>
                    <a asp-controller="Servicios" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Servicios</a>
                    <a asp-controller="Ordenes" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Ordenes</a>
                    <a asp-controller="Facturacion" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Facturacion</a>
                    <a asp-controller="Repuestos" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Repuestos</a>
                    <a asp-controller="Empleados" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Empleados</a>
                    <a asp-controller="Pagos" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Pagos</a>
                    <a asp-controller="Reportes" asp-action="Index" class="block rounded-2xl px-4 py-3 transition hover:bg-cyan-500/15 hover:text-cyan-200">Reportes</a>
                </nav>
            </div>

            <div class="space-y-3">
                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                    <p class="text-xs uppercase tracking-[0.25em] text-slate-400">usuario</p>
                    <p class="mt-2 text-sm font-semibold text-white">@(User.Identity?.Name ?? "sesion activa")</p>
                </div>
                <button type="button"
                        onclick="cerrarSesion()"
                        class="w-full rounded-2xl bg-cyan-400 px-4 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-300">
                    Cerrar sesion
                </button>
            </div>
        </aside>

        <main class="flex-1 p-6 md:p-8">
            <div class="mb-6 rounded-3xl border border-slate-200/70 bg-white/80 px-6 py-5 shadow-sm backdrop-blur">
                <p class="text-xs uppercase tracking-[0.35em] text-slate-400">taller mecanico</p>
                <h1 class="mt-2 text-3xl font-black text-slate-900">@ViewData["Title"]</h1>
            </div>

            <div class="rounded-3xl border border-white/60 bg-white/85 p-6 shadow-xl shadow-slate-200/70 backdrop-blur">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        async function cerrarSesion() {
            try {
                await fetch('/api/auth/logout', {
                    method: 'POST'
                });
            } catch (error) {
                console.error(error);
            } finally {
                localStorage.removeItem('auth_token');
                localStorage.removeItem('auth_username');
                localStorage.removeItem('auth_rol');
                window.location.href = '/Auth/Login';
            }
        }
    </script>
</body>
</html>
