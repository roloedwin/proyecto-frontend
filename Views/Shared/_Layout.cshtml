<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TallerMecanico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TallerMecanico.styles.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-100">

    <div class="flex">

        <aside class="w-64 bg-gray-900 text-white min-h-screen p-5">
            <h2 class="text-2xl font-bold mb-6">Taller Mecanico Senora Burgos</h2>

            <ul class="space-y-3">

                <li><a asp-controller="Home" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Inicio</a></li>
                <li><a asp-controller="Clientes" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Clientes</a></li>
                <li><a asp-controller="Vehiculos" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Vehículos</a></li>
                <li><a asp-controller="Servicios" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Servicios</a></li>
                <li><a asp-controller="Ordenes" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Órdenes</a></li>
                <li><a asp-controller="Facturacion" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Facturación</a></li>
                <li><a asp-controller="Repuestos" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Repuestos</a></li>
                <li><a asp-controller="Empleados" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Empleados</a></li>
                <li><a asp-controller="Pagos" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Pagos</a></li>
                <li><a asp-controller="Reportes" asp-action="Index" class="block p-2 hover:bg-gray-700 rounded">Reportes</a></li>

            </ul>
        </aside>

        <main class="flex-1 p-6">
            @RenderBody()
        </main>

    </div>
</body>
</html>
