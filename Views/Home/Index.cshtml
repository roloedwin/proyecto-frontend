@{
    ViewData["Title"] = "Inicio";
}

<div class="space-y-8">
    <section class="grid gap-6 lg:grid-cols-[1.35fr_0.95fr]">
        <div class="overflow-hidden rounded-3xl bg-slate-950 p-8 text-white shadow-2xl">
            <p class="text-xs uppercase tracking-[0.35em] text-cyan-300">Panel principal</p>
            <h2 class="mt-4 max-w-xl text-4xl font-black leading-tight">Tablero de control de clientes, vehiculos y cobros .</h2>
            <p class="mt-4 max-w-2xl text-sm text-slate-300">
                Acceso protegido por JWT y autenticacion encryptada
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
                <a asp-controller="Clientes" asp-action="Index" class="rounded-2xl bg-cyan-400 px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-300">Ver clientes</a>
                <a asp-controller="Ordenes" asp-action="Index" class="rounded-2xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Ver ordenes</a>
            </div>
        </div>

        <div class="grid gap-4">
            <div class="rounded-3xl bg-cyan-500 p-6 text-slate-950 shadow-lg">
                <p class="text-xs font-bold uppercase tracking-[0.35em] text-cyan-950/70">clientes</p>
                <p class="mt-4 text-5xl font-black">@ViewBag.TotalClientes</p>
                <p class="mt-2 text-sm font-medium text-cyan-950/80">Registros disponibles para atencion y seguimiento.</p>
            </div>

            <div class="rounded-3xl bg-emerald-500 p-6 text-slate-950 shadow-lg">
                <p class="text-xs font-bold uppercase tracking-[0.35em] text-emerald-950/70">vehiculos</p>
                <p class="mt-4 text-5xl font-black">@ViewBag.TotalVehiculos</p>
                <p class="mt-2 text-sm font-medium text-emerald-950/80">Base activa para recepcion y ordenes de trabajo.</p>
            </div>
        </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-sm font-bold text-slate-500">Servicios</p>
            <p class="mt-3 text-sm text-slate-700">Administracion de servicios disponibles del taller </p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-sm font-bold text-slate-500">Repuestos</p>
            <p class="mt-3 text-sm text-slate-700">Relaciona proveedores con inventario y consolida costos por trabajo.</p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-sm font-bold text-slate-500">Pagos</p>
            <p class="mt-3 text-sm text-slate-700">Centraliza la cobranza para controlar facturas y metodos de pago.</p>
        </div>
    </section>
</div>

<script>
    Swal.fire({
        title: 'Acceso correcto',
        text: 'Bienvenido al tablero del taller mecanico.',
        icon: 'success',
        timer: 1800,
        showConfirmButton: false
    });
</script>
