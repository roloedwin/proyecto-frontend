@model TallerMecanico.Models.Vehiculo

<h1 class="text-2xl font-bold mb-4">Editar Vehículo</h1>

<form asp-action="Edit">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Marca</label>
        <input asp-for="Marca" class="border p-2 w-full" />
    </div>

    <div class="mb-3">
        <label>Modelo</label>
        <input asp-for="Modelo" class="border p-2 w-full" />
    </div>

    <div class="mb-3">
        <label>Placa</label>
        <input asp-for="Placa" class="border p-2 w-full" />
    </div>

    <div class="mb-3">
        <label>Cliente</label>
        <select asp-for="ClienteId" asp-items="ViewBag.Clientes"
                class="border p-2 w-full">
        </select>
    </div>

    <button class="bg-blue-500 text-white px-4 py-2 rounded">
        Guardar cambios
    </button>

</form>